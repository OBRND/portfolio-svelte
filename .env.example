# Copy to .env.local and fill in. On Vercel, set the same variables in
# Project Settings > Environment Variables (Production + Preview).

# Supabase project, from Project Settings > API.
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Contact form notifications, from https://resend.com/api-keys.
# Sending uses Resend's shared onboarding@resend.dev address, which only
# delivers to the email the Resend account is registered under, so
# CONTACT_TO_EMAIL must match that address (or verify your own domain).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_TO_EMAIL=you@example.com
